# Copia este archivo como .env.local y ajusta los valores (no se sube a git).

# URL del backend
VITE_API_URL=http://localhost:5088

# Mapa (Leaflet). Si se dejan vacías se usan los servidores públicos de OpenStreetMap,
# que solo son para desarrollo / bajo tráfico. En producción usar un proveedor o servidor propio.
VITE_MAPA_TILES_URL=
VITE_MAPA_ATRIBUCION=
